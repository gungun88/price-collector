NODE_ENV=development
PORT=4100
HOST=0.0.0.0

# PostgreSQL connection string for the self-hosted database.
DATABASE_URL=postgres://priceai:priceai_dev_password@localhost:5432/priceai

# Used to hash submitter IPs and future admin sessions. Change in production.
APP_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional shared secret used when the Next.js frontend forwards client fingerprints.
PRICEAI_FORWARD_SECRET=change-this-forward-secret

# Development password is: admin
# Generate a production hash with: node scripts/hash-password.mjs your-password
ADMIN_PASSWORD_HASH=scrypt$c6deaffb182895e760d9a10b468f46ea$964f4ed85587081a6f45688f667bc469b606b40a7253bf0a9b23b20805cd947bdda9b6ae43d0845b9c18bd9c647b9b43e96654d96ec4a8d9e12819e6f7edf4e8
# Docker Compose can use base64url form to avoid `$` interpolation issues.
ADMIN_PASSWORD_HASH_B64=c2NyeXB0JGM2ZGVhZmZiMTgyODk1ZTc2MGQ5YTEwYjQ2OGY0NmVhJDk2NGY0ZWQ4NTU4NzA4MWE2ZjQ1Njg4ZjY2N2JjNDY5YjYwNmI0MGE3MjUzYmYwYTliMjNiMjA4MDVjZDk0N2JkZGE5YjZhZTQzZDA4NDViOWMxOGJkOWM2NDdiOWI0M2U5NjY1NGQ5NmVjNGE4ZDllMTI4MTllNmY3ZWRmNGU4
COOKIE_SECURE=false

# Optional comma-separated CORS origins for local development.
CORS_ORIGINS=http://localhost:3000
