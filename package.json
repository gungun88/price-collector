{
  "name": "ai-price-hub",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node_modules/node/bin/node node_modules/next/dist/bin/next dev --webpack",
    "build": "node_modules/node/bin/node node_modules/next/dist/bin/next build --webpack",
    "audit:licenses": "node scripts/check-direct-dependency-licenses.mjs",
    "audit:sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "start": "node_modules/node/bin/node node_modules/next/dist/bin/next start",
    "lint": "node_modules/node/bin/node node_modules/eslint/bin/eslint.js",
    "typecheck": "node_modules/node/bin/node node_modules/next/dist/bin/next typegen && node_modules/node/bin/node node_modules/typescript/bin/tsc --noEmit",
    "test": "npm run typecheck",
    "selfhost:up": "docker compose -f docker-compose.selfhost.yml up -d --build",
    "selfhost:down": "docker compose -f docker-compose.selfhost.yml down",
    "selfhost:logs": "docker compose -f docker-compose.selfhost.yml logs -f api",
    "selfhost:migrate": "cd server && node scripts/migrate.mjs",
    "selfhost:smoke": "node server/scripts/smoke-admin.mjs",
    "update:star-history": "node scripts/update-star-history.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.14.0",
    "next": "16.2.9",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "node": "^24.14.0",
    "playwright-core": "^1.59.1",
    "rclone.js": "^0.6.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.99.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
