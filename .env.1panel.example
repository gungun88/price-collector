# Required: database
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# Required: backend API
APP_SECRET=replace-with-a-long-random-secret-at-least-32-chars
PRICEAI_FORWARD_SECRET=replace-with-a-long-random-forward-secret
ADMIN_PASSWORD_HASH_B64=replace-with-output-from-server-scripts-hash-password
CORS_ORIGINS=https://your-domain.example

# Required: web
WEB_PORT=3000
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
ADMIN_SESSION_VERSION=1
CRON_SECRET=replace-with-a-long-random-cron-secret
API_TRANSIT_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-chars

# Optional: risk review
PRICEAI_RISK_REVIEW_API_KEY=
PRICEAI_RISK_REVIEW_BASE_URL=
PRICEAI_RISK_REVIEW_MODEL=

# Optional: public browser variables, baked at web image build time
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_ALLOWED_DOMAINS=
NEXT_PUBLIC_TRANSIT_DETECTOR_API_BASE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
